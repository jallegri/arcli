# Local development image for the Wikimedia/Arc lab. The release Dockerfile
# remains GoReleaser-driven; this target compiles the checked-out fork source.
FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/arcli ./cmd/arcli

FROM alpine:3.22

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 65532 arcli \
    && adduser -S -D -H -u 65532 -G arcli arcli

COPY --from=build --chown=65532:65532 /out/arcli /usr/local/bin/arcli

ENV HOME=/tmp
USER 65532:65532

CMD ["tail", "-f", "/dev/null"]
